}
object "severity : NumericSeverity" as severity {
  level = 4
}
object "eventSummary : SecurityEventSummary" as summary {
  eventType = "LOGIN_EVENT"
  sourceIp = "203.0.113.19"
  severity = 4
}
object "audit : SecurityLog" as log {
  entries = 17
}
object "dailyReport : SecurityReport" as report {
  reportId = "REP-2026-08-25"
  periodCovered = "2026-08-25"
}

device -- login1 : generated
device -- login2 : generated
device -- login3 : generated
device -- network : generated
detector *-- rule : configured rule
detector ..> login1 : analyzed
detector ..> login2 : analyzed
detector ..> login3 : analyzed
detector ..> threat : created from pattern
threat -- alert : raised
incident o-- alert
incident o-- evidence
incident o-- action
action --> device : isolated
login1 ..> severity : int -> object -> int
login1 ..> summary : class conversion
log ..> incident : audited
report ..> threat : summarized
report ..> incident : summarized
report ..> log : counted

note right of login3
  EVT-BAD with severity 9 and an event
  with missing identity are rejected
  before entering this graph.
end note
@enduml
