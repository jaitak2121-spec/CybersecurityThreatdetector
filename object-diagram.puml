@startuml object-diagram
left to right direction
skinparam objectAttributeIconSize 0
title Simple Object Diagram - Full Demo Scenario

object "authServer : Device" as device {
  status = ISOLATED
}
object "login1 : LoginEvent" as login1 {
  failedAttempts = 1
  calculatedSeverity = 3
}
object "login2 : LoginEvent" as login2 {
  failedAttempts = 2
  calculatedSeverity = 4
}
object "login3 : LoginEvent" as login3 {
  failedAttempts = 3
  calculatedSeverity = 4
}
object "sshEvent : NetworkEvent" as network {
  port = 22
  protocol = TCP
  calculatedSeverity = 4
}
object "detector : ThreatDetector" as detector
object "bruteForce : Threat" as threat {
  severity = 4
  status = CONTAINED
}
object "incident : Incident" as incident {
  status = CONTAINED
}
object "evidence : Evidence" as evidence
object "isolate : ResponseAction" as action {
  status = COMPLETED
}
object "report : SecurityReport" as report

device -- login1
device -- login2
device -- login3
device -- network
detector ..> login1 : analyzes
detector ..> login2 : analyzes
detector ..> login3 : analyzes
detector ..> network : analyzes
detector ..> threat : detects pattern
threat --> incident : escalates
incident o-- evidence
incident o-- action
action --> device : isolates safely
report ..> threat : summarizes
report ..> incident : summarizes

note bottom of login3
  Severity is calculated from event facts.
  It is not supplied manually.
end note
@enduml
