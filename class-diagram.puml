@startuml class-diagram
!pragma layout smetana
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
hide empty members
title Implemented Class Diagram - Cybersecurity Threat Detector

package "Event model" {
  class EventInfo {
    # sourceIp: string
    + getSourceIp(): string
    + displayInfo(): void
  }

  class SecurityEvent {
    - eventId: string
    - eventType: string
    - timestamp: string
    - severity: int
    # rawData: string
    + getSeverity(): int
    + displayEvent(): void
    + clone(): SecurityEvent*
  }

  class LoginEvent {
    - username: string
    - loginSuccessful: bool
    + isFailedLogin(): bool
    + displayEvent(): void
    + clone(): SecurityEvent*
  }

  class "NetworkEvent <<final>>" as NetworkEvent {
    - destinationPort: int
    - protocol: string
    + getDestinationPort(): int
    + displayEvent(): void
    + clone(): SecurityEvent*
  }
}

package "Detection" {
  class DetectionRule {
    - ruleId: string
    - conditionType: string
    - severityThreshold: int
    - isEnabled: bool
    + matches(event: SecurityEvent): bool
  }

  class ThreatDetector {
    - rules: vector<DetectionRule>
    + addRule(rule: DetectionRule): void
    + detectThreat(event: SecurityEvent): Threat
    + detectThreat(type: string, severity: int, ip: string): Threat
    + detectThreat(events: vector<SecurityEvent*>, ip: string, threshold: int): Threat
  }

  class Threat {
    - threatId: string
    - threatType: string
    - severity: int
    - status: string
    {static} - threatCount: int
    + getLevel(): ThreatLevel
    + updateStatus(status: string): void
    {static} + getThreatCount(): int
  }

  class "Threat::ThreatLevel" as ThreatLevel {
    - level: int
    + describe(): string
  }
}

package "Incident response" {
  class Device {
    - deviceId: string
    - status: string
    + isolate(): void
  }
  class Alert {
    - alertId: string
    - severity: int
    - status: string
    + markFalsePositive(reason: string): void
  }
  class Evidence {
    - evidenceId: string
    - evidenceType: string
    - description: string
  }
  class ResponseAction {
    - actionId: string
    - actionType: string
    - status: string
    - outcome: string
    + execute(device: Device): bool
  }
  class Incident {
    - incidentId: string
    - status: string
    - alerts: vector<Alert*>
    - evidenceList: vector<Evidence*>
    - actions: vector<ResponseAction*>
    + addAlert(alert: Alert*): void
    + addEvidence(evidence: Evidence*): void
    + executeResponse(action: ResponseAction*, device: Device): bool
  }
}

package "Audit" {
  class SecurityLog {
    - entries: vector<LogEntry>
    + writeLogEntry(...): void
    + countByType(type: string): int
  }
  class "SecurityLog::LogEntry" as LogEntry {
    - timestamp: string
    - eventType: string
    - message: string
  }
  class SecurityReport {
    + generateSummary(threats, alerts, incidents, log): void
  }
}

package "Validation and conversion" {
  class NumericSeverity {
    - level: int
    + NumericSeverity(value: int)
    + operator int(): int
  }
  class SecurityEventSummary {
    - eventType: string
    - sourceIp: string
    - severity: int
    + SecurityEventSummary(event: SecurityEvent)
  }
  class SecurityException
  class InvalidSeverityException
  class InvalidEventException
}

EventInfo <|-- SecurityEvent : virtual inheritance
SecurityEvent <|-- LoginEvent
SecurityEvent <|-- NetworkEvent
Threat *-- ThreatLevel
SecurityLog *-- LogEntry

ThreatDetector *-- "0..*" DetectionRule
ThreatDetector ..> SecurityEvent : analyzes
ThreatDetector ..> Threat : creates
DetectionRule ..> LoginEvent : dynamic_cast
DetectionRule ..> NetworkEvent : dynamic_cast

Device "1" -- "0..*" SecurityEvent : source device
Threat "1" -- "0..1" Alert : raises
Incident "1" o-- "1..*" Alert
Incident "1" o-- "0..*" Evidence
Incident "1" o-- "0..*" ResponseAction
ResponseAction --> Device : targets
SecurityReport ..> Threat
SecurityReport ..> Alert
SecurityReport ..> Incident
SecurityReport ..> SecurityLog

SecurityException <|-- InvalidSeverityException
SecurityException <|-- InvalidEventException
SecurityEvent ..> InvalidSeverityException : may throw
SecurityEvent ..> InvalidEventException : may throw
NumericSeverity ..> InvalidSeverityException : may throw
SecurityEventSummary ..> SecurityEvent : converts from
NumericSeverity ..> SecurityEvent : converts severity
@enduml
