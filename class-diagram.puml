@startuml class-diagram
left to right direction
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
hide empty members
title Simple Class Diagram - Cybersecurity Threat Detector

package "Events" {
  class EventInfo {
    # sourceIp: string
  }
  class SecurityEvent {
    - eventId: string
    - eventType: string
    - severity: int
    + displayEvent()
  }
  class LoginEvent {
    - username: string
    - loginSuccessful: bool
  }
  class "NetworkEvent <<final>>" as NetworkEvent {
    - destinationPort: int
    - protocol: string
  }
  class NumericSeverity {
    - level: int
    {static} + forLogin(success, failures, afterLock): NumericSeverity
    {static} + forNetwork(port, attempts, unauthorized): NumericSeverity
  }
}

package "Detection" {
  class DetectionRule {
    - conditionType: string
    - severityThreshold: int
    + matches(event): bool
  }
  class ThreatDetector {
    - rules: vector<DetectionRule>
    + detectThreat(event): Threat
    + detectThreat(events, ip, threshold): Threat
  }
  class Threat {
    - threatType: string
    - severity: int
    - status: string
  }
}

package "Incident Response" {
  class Alert
  class Incident {
    + addAlert(alert)
    + addEvidence(evidence)
    + executeResponse(action, device)
  }
  class Evidence
  class ResponseAction {
    + execute(device): bool
  }
  class Device {
    + isolate()
  }
}

package "Supporting Services" {
  interface Runnable
  class Thread
  class EventMonitoringThread
  class EventMonitoringTask
  class ThreadSafeEventMetrics
  class SecurityLog
  class SecurityReport
  class SecurityException
}

EventInfo <|-- SecurityEvent : virtual
SecurityEvent <|-- LoginEvent
SecurityEvent <|-- NetworkEvent
LoginEvent ..> NumericSeverity : calculates score
NetworkEvent ..> NumericSeverity : calculates score

ThreatDetector *-- DetectionRule
ThreatDetector ..> SecurityEvent : analyzes
ThreatDetector ..> Threat : creates

Threat ..> Alert : raises
Incident o-- Alert
Incident o-- Evidence
Incident o-- ResponseAction
ResponseAction --> Device : simulated action

Runnable <|.. Thread
Thread <|-- EventMonitoringThread
Runnable <|.. EventMonitoringTask
EventMonitoringThread --> ThreadSafeEventMetrics
EventMonitoringTask --> ThreadSafeEventMetrics

SecurityEvent ..> SecurityException : invalid input

note bottom of SecurityReport
  SecurityLog records the workflow.
  SecurityReport summarizes its results.
end note

note bottom of NumericSeverity
  Login score:
  success = 1
  failure = 1 + L + R + B + C

  Network score:
  1 + 2*restricted + repeated + unauthorized
end note
@enduml
