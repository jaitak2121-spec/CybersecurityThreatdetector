flowchart LR
    USER["Visitor / Security Analyst"]

    subgraph SYSTEM["Cybersecurity Threat Detection Simulator"]
        SELECT(("Select scenario"))
        RUN(("Run simulation"))
        VALIDATE(("Validate events"))
        MONITOR(("Process events with threads"))
        DETECT(("Detect threats and errors"))
        RESPOND(("Simulate incident response"))
        RESULTS(("View logs and report"))
        COMPARE(("Compare run summaries"))

        SELECT --> RUN
        RUN -. "<<include>>" .-> VALIDATE
        RUN -. "<<include>>" .-> MONITOR
        MONITOR -. "<<include>>" .-> DETECT
        DETECT -. "<<include>>" .-> RESPOND
        RESPOND -. "<<include>>" .-> RESULTS
        RESULTS -. "<<extend>> after another run" .-> COMPARE
    end

    USER --- SELECT
    USER --- RESULTS
    USER --- COMPARE
